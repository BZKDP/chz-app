# Честный Знак — переменные окружения (пример). Скопируйте в .env и заполните.
# Значения можно задавать здесь ИЛИ в data/config.local.json (см. data/config.local.json.example).

# --- HTTP сервер ---
PORT=3030

# --- Контур интеграции СУЗ / True API ---
# Идентификатор OMS и внешнего подключения (omsConnection) из личного кабинета СУЗ.
CHZ_OMS_ID=
CHZ_OMS_CONNECTION=
# Товарная группа ЧЗ (для БАД — bio).
CHZ_PRODUCT_GROUP=bio
# ИНН организации (как в сертификате УКЭП).
CHZ_ORG_INN=
# apikey Национального каталога (ЛК НК → Профиль → «Токен для доступа к API»).
CHZ_NK_API_KEY=

# --- Подпись УКЭП (CryptoPro) на офисном компьютере ---
# SSH-хост/пользователь машины с подписью, отпечаток сертификата.
CHZ_SIGNER_HOST=
CHZ_SIGNER_USER=
CHZ_SIGNER_THUMBPRINT=

# --- Очередь внешнего сайта сборки (необязательно) ---
CHZ_WORKER_ENABLED=0
CHZ_WORKER_URL=
CHZ_WORKER_ID=
# Общий секрет HMAC, минимум 32 символа.
CHZ_WORKER_SECRET=
CHZ_WORKER_POLL_MS=5000

# --- Удалённый кабинет (remote-site), читается из remote-site/config.json ---
# workerSecret, cookieSecret (>=32 симв.), authUser, authPasswordHash (salt:scryptHex), publicOrigin
